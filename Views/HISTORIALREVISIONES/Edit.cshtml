@model AutoCar360.Controllers.HISTORIALREVISIONES

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    body {
        background-color: #1b2b2c;
        color: #00d6d6;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        text-align: center;
    }

    h2, h4 {
        color: #00d6d6;
        font-weight: bold;
    }

    .form-horizontal {
        max-width: 400px;
        margin-left: 15%;
        margin-top: 30px;
    }

    .text {
        text-align: left;
        margin-left: 5%;
        font-weight: bold;
    }

    .form-group {
        margin-bottom: 20px;
    }

    label {
        display: block;
        margin-bottom: 5px;
        color: #00d6d6;
        font-weight: bold;
    }

    input[type="text"],
    input[type="number"],
    textarea,
    select {
        width: 100%;
        padding: 8px;
        background-color: #2f3e3f;
        border: none;
        color: #00d6d6;
    }

    .card-buttons {
        display: flex;
        gap: 10px;
        margin-top: 4%
    }

        .card-buttons a, .card-buttons input {
            background-color: #132526;
            color: #00e1ff;
            text-decoration: none;
            padding: 6px 12px;
            text-align: center;
            display: inline-block;
            border: none;
        }

            .card-buttons a:hover, .card-buttons input:hover {
                background-color: #00e1ff;
                color: #132526;
            }


    .visually-hidden {
        display: none;
    }

    .action-buttons {
        display: flex;
        gap: 20px;
        margin-top: 30px;
    }

    .back-link {
        display: inline-block;
        margin-top: 20px;
        color: #00d6d6;
    }
</style>
<h2>Edit</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    
<div class="form-horizontal">
    <h4>HISTORIALREVISIONES</h4>
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id_HistorialRevisiones)

    <div class="form-group visually-hidden">
        @Html.LabelFor(model => model.Id_RevisionesVehiculo, "Id_RevisionesVehiculo", htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.DropDownList("Id_RevisionesVehiculo", null, htmlAttributes: new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.Id_RevisionesVehiculo, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group visually-hidden">
        @Html.LabelFor(model => model.HistorialRevisiones_Fecha, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.HistorialRevisiones_Fecha, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.HistorialRevisiones_Fecha, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.HistorialRevisiones_Taller, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.HistorialRevisiones_Taller, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.HistorialRevisiones_Taller, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.HistorialRevisiones_Precio, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.HistorialRevisiones_Precio, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.HistorialRevisiones_Precio, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group visually-hidden">
        @Html.LabelFor(model => model.HistorialRevisiones_km, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.HistorialRevisiones_km, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.HistorialRevisiones_km, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.HistorialRevisiones_Comentarios, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.HistorialRevisiones_Comentarios, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.HistorialRevisiones_Comentarios, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="card-buttons">
        <input type="submit" value="Agregar" class="btn" />
        <a href="@Url.Action("Index")" class="btn">Volver</a>

    </div>
</div>
}

