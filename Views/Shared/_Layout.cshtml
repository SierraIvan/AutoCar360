<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Mi aplicación ASP.NET</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container">
            @Html.ActionLink("AutoCar360", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Alternar navegación" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li>@Html.ActionLink("VEHICULOS", "Index", "VEHICULOS", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("USUARIOS", "Index", "USUARIOS", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("MANTENIMIENTOS", "Index", "PROXIMOMANTENIMIENTO", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("REVISIONES", "Index", "PROXIMASREVISIONES", new { area = "" }, new { @class = "nav-link" })</li>
                </ul>
                <img src="~/Imagenes/logo360.png" alt="AutoCar360 Logo" class="img-fluid" style="height: 60px; width: 80px">
            </div>
        </div>
    </nav>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer class="custom-footer">
            <div class="container">
                <div class="row">
                    <!-- Columna 1: Contacto -->
                    <div class="col-md-4 footer-column">
                        <h4>Contacto</h4>
                        <ul>
                            <li></i> ivan.sierra.perez@colegiolitterator.com</li>
                            <li> +34 123 456 789</li>
                            <li>C. Patrimonio Mundial, 5, 28300 Pau, Madrid</li>
                        </ul>
                    </div>

                    <!-- Columna 2: Términos y Condiciones -->
                    <div class="col-md-4 footer-column">
                        <h4>Legal</h4>
                        <ul>
                            <li>@Html.ActionLink("Términos y Condiciones", "Index", "TERMINOS", new { area = "" }, new { @class = "nav-link" })</li>
                            <li>@Html.ActionLink("Política de Privacidad", "Index", "TERMINOS", new { area = "" }, new { @class = "nav-link" })</li>
                            <li>@Html.ActionLink("Aviso Legal", "Index", "TERMINOS", new { area = "" }, new { @class = "nav-link" })</li>
                        </ul>
                    </div>

                  
                </div>
                <div class="copyright">
                    &copy; @DateTime.Now.Year - AutoCar360 | Iván Sierra Pérez
                </div>
            </div>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
