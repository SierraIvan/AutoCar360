@model IEnumerable<AutoCar360.Controllers.HISTORIALMANTENIMIENTO>

@{
    ViewBag.Title = "Historial Mantenimiento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background-color: #1c2c2c;
        color: #00cfff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    h2 {
        text-align: center;
        color: #00e1ff;
        margin-bottom: 30px;
    }

    .cards-container {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 20px;
    }

    .card {
        background-color: #1e2d2f;
        padding: 20px;
        margin: 20px 80px;
        border-radius: 5px;
        justify-content: space-between;
        align-items: flex-start;
        display: inline-flex;
        width: 400px;
    }

    .card-info {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

        .card-info label {
            font-weight: bold;
            color: #00e1ff;
        }

    .card-buttons {
        display: flex;
        gap: 10px;
    }

        .card-buttons a {
            background-color: #132526;
            color: #00e1ff;
            text-decoration: none;
            padding: 6px 12px;
            text-align: center;
            display: inline-block;
            border: none;
        }

            .card-buttons a:hover {
                background-color: #00e1ff;
                color: #132526;
            }
</style>

<h2>Historial Mantenimiento</h2>
<div class="cards-container">
    @foreach (var item in Model)
    {
        <div class="card">
            <div class="card-info">
                <div><label>Matrícula:</label> @item.MANTENIMIENTOVEHICULO.VEHICULOS.Vehiculo_Matricula</div>
                <div><label>Fecha:</label> @(( (DateTime)item.HistorialMantenimiento_Fecha ).ToString("yyyy-MM-dd"))</div>
                <div><label>Tipo de cambio:</label> @item.MANTENIMIENTOVEHICULO.TIPOMANTENIMIENTO.Mantenimiento_Nombre</div>
            </div>
            <div class="card-buttons">
                <a href="@Url.Action("Edit", new { id = item.Id_HistorialMantenimiento })">Editar</a>
                <a href="@Url.Action("Details", new { id = item.Id_HistorialMantenimiento })">Mostrar Datos</a>
            </div>
        </div>
    }
</div>

