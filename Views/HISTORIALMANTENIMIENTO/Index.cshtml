@model IEnumerable<AutoCar360.Controllers.HISTORIALMANTENIMIENTO>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.HistorialMantenimiento_Fecha)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.HistorialMantenimiento_Taller)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.HistorialMantenimiento_Precio)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.HistorialMantenimiento_Km)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.HistorialMantenimiento_Comentarios)
        </th>
        <th>
            Tipo de Mantenimiento
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @(( (DateTime)item.HistorialMantenimiento_Fecha ).ToString("yyyy-MM-dd"))

        </td>
        <td>
            @Html.DisplayFor(modelItem => item.HistorialMantenimiento_Taller)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.HistorialMantenimiento_Precio)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.HistorialMantenimiento_Km)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.HistorialMantenimiento_Comentarios)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.MANTENIMIENTOVEHICULO.TIPOMANTENIMIENTO.Mantenimiento_Nombre)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id = item.Id_HistorialMantenimiento }) |
            @Html.ActionLink("Details", "Details", new { id = item.Id_HistorialMantenimiento }) |
            @Html.ActionLink("Delete", "Delete", new { id = item.Id_HistorialMantenimiento })
        </td>
    </tr>
}

</table>
