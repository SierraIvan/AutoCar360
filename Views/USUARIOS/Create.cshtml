@model AutoCar360.Controllers.USUARIOS
@{
    ViewBag.Title = "Registrarse";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Registrarse</title>
    <style>
        body {
            background-color: #132426;
            font-family: 'Segoe UI', sans-serif;
            color: #00eaff;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            flex-direction: column;
        }

        h1 {
            font-size: 36px;
            font-weight: bold;
            color: #00eaff;
            margin-bottom: 40px;
        }

        .form-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 100%;
        }

        input[type="text"],
        input[type="password"] {
            width: 300px;
            padding: 12px;
            background-color: #1e2b2d;
            border: none;
            color: #cccccc;
            border-radius: 5px;
            margin-bottom: 15px;
            font-size: 14px;
        }

        .button-container {
            display: flex;
            align-items: center;
            margin-top: 10px;
            gap: 20px;
        }

        input[type="submit"].button {
            background-color: #00eaff;
            color: #000000;
            padding: 12px 20px;
            border: none;
            border-radius: 6px;
            font-weight: bold;
            font-size: 14px;
            cursor: pointer;
            transition: background-color 0.3s;
        }

        .button-link {
            color: #00eaff;
            text-decoration: underline;
            font-size: 14px;
            background: none;
            border: none;
            cursor: pointer;
            font-weight: normal;
        }

        .field-validation-error
        {
            color: #ff6b6b;
            font-size: 12px;
            margin-top: -10px;
            margin-bottom: 10px;
            text-align: center;
        }

        .validation-summary-custom {
            color: #ff6b6b;
            font-size: 12px;
            margin-top: 20px;
            margin-bottom: 10px;
            text-align: center;
        }
    </style>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $('form').submit(function (e) {
                $('.field-validation-error').remove();
                $('.validation-summary-custom').remove();
                var isValid = true;

                if ($('#Usuario_Nombre').val().trim() === '') {
                    $('#Usuario_Nombre').after('<span class="field-validation-error">El nombre de usuario es requerido</span>');
                    isValid = false;
                }

                if ($('#Usuario_Password').val().trim() === '') {
                    $('#Usuario_Password').after('<span class="field-validation-error">La contraseña es requerida</span>');
                    isValid = false;
                }

                if (!isValid) {
                    e.preventDefault();
                    $('.button-container').after('<div class="validation-summary-custom">Por favor complete todos los campos requeridos</div>');
                }
            });
        });
    </script>
</head>
<body>
    <h1>AUTOCAR360</h1>
    <h2>Registrarse</h2>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="form-container">
            @Html.TextBoxFor(model => model.Usuario_Nombre, new { @type = "text", placeholder = "Nuevo Usuario", id = "Usuario_Nombre" })

            @Html.PasswordFor(model => model.Usuario_Password, new { placeholder = "Contraseña", id = "Usuario_Password" })

            @Html.HiddenFor(model => model.Usuario_FechaRegistro, new { @Value = DateTime.Now.ToString("yyyy-MM-dd") })

            <div class="button-container">
                <input type="submit" value="Registrarse" class="button" />
                <a href="@Url.Action("Index", "USUARIOS")" class="button-link">Volver</a>
            </div>
        </div>
    }
</body>
</html>
