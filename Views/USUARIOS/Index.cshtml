@model IEnumerable<AutoCar360.Controllers.USUARIOS>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Usuario_Nombre)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Usuario_Password)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Usuario_FechaRegistro)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Usuario_Nombre)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Usuario_Password)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Usuario_FechaRegistro)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.Id_Usuario }) |
            @Html.ActionLink("Details", "Details", new { id=item.Id_Usuario }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.Id_Usuario })
        </td>
    </tr>
}

</table>
