@model AutoCar360.Models.LoginViewModel

@{
    ViewBag.Title = "Iniciar sesión";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Login</title>
    <style>
        body {
            background-color: #1e2b2d;
            font-family: 'Segoe UI', sans-serif;
            color: #00e5ff;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .login-box {
            text-align: center;
        }

        input, button {
            margin: 8px;
            padding: 10px;
            width: 250px;
            border: none;
            border-radius: 5px;
        }

        input {
            background-color: #2d3d3f;
            color: white;
        }

        button {
            background-color: #00e5ff;
            color: #1e2b2d;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <div class="login-box">

        <h1>AUTOCAR360</h1>

        @using (Html.BeginForm("Index", "USUARIOS", FormMethod.Post))
        {
            <div>
                <input type="text" name="Usuario_Nombre" placeholder="Usuario" required />
            </div>
            <div>
                <input type="password" name="Usuario_Password" placeholder="Contraseña" required />
            </div>
            <div>
                <button type="submit">Iniciar sesión</button>
                @Html.ActionLink("Registrarse", "Create", "USUARIOS", null, new { @style = "margin-left:10px; color: #00e5ff;" })

                @*{ @style = "margin-left:10px; color: #00e5ff;" }*@
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div style="margin-top:10px;">
                <span style="color:red;">@ViewBag.Error</span>
            </div>
        }
    </div>
</body>
</html>
