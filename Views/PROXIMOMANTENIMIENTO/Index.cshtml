@model IEnumerable<AutoCar360.Controllers.PROXIMOMANTENIMIENTO>

@{
    ViewBag.Title = "Próximos Mantenimientos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Próximos Mantenimientos</h2>

<p>
    @Html.ActionLink("Crear Nuevo", "Create", "MANTENIMIENTOVEHICULO")
</p>
<p  class="btn btn-success">
    @Html.ActionLink("Historial", "Index", "HISTORIALMANTENIMIENTO")
</p>
<table class="table">
    <tr>
        <th>
            Matrícula
        </th>
        <th>
            Tipo de Mantenimiento
        </th>
        <th>
            Próximo Mantenimiento (Km)
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.MANTENIMIENTOVEHICULO.VEHICULOS.Vehiculo_Matricula)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MANTENIMIENTOVEHICULO.TIPOMANTENIMIENTO.Mantenimiento_Nombre) 
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProximoMantenimiento_Km)
            </td>
            <td>
                @Html.ActionLink("Editar", "Edit", new { id = item.Id_ProximoMantenimiento }) |
                @Html.ActionLink("Detalles", "Details", new { id = item.Id_ProximoMantenimiento }) |
                @Html.ActionLink("Eliminar", "Delete", new { id = item.Id_ProximoMantenimiento })
            </td>
        </tr>
    }
</table>