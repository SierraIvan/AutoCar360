﻿@model IEnumerable<AutoCar360.Controllers.PROXIMOMANTENIMIENTO>

@{
    ViewBag.Title = "Próximos Mantenimientos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background-color: #1c2c2c;
        color: #00cfff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    .cards{
        width:100%;
    }

    .card {
        background-color: #2d3f3f;
        text-decoration: none;
        color: #00cfff;
        padding: 8px;
        margin-bottom: 10px;
        border-radius: 5px;
        width: 65%;
        margin-left: auto;
        margin-right: auto;
    }

    .containter-boton {
        width: 65%;
        margin-left: auto;
        margin-right: auto;
    }
    .boton {
        background-color: #2d3f3f;
        text-decoration: none;
        color: #00cfff;
        padding: 8px;
        margin-bottom: 10px;
        border-radius: 5px;
    }

    .parrafo {
        display: contents;
        font-style: italic;
    }
</style>

<body>

    <h2 class="text-center mt-4">PRÓXIMOS MANTENIMIENTOS</h2>
    <div class="containter-boton">
        <div class="d-flex justify-content-between my-4">
            <a href="@Url.Action("Index", "HISTORIALMANTENIMIENTO")" class="boton">Mostrar historial de mantenimientos</a>
            <a href="@Url.Action("Create", "MANTENIMIENTOVEHICULO")" class="boton">Realizar mantenimiento</a>
        </div>
    </div>
    <div class="cards">
        @foreach (var item in Model)
        {
            <div class="card">
                <div class="mb-2">
                    <strong>Matrícula:</strong><p class="parrafo"> @item.MANTENIMIENTOVEHICULO.VEHICULOS.Vehiculo_Matricula </p>
                </div>
                <div class="mb-2">
                    <strong>Tipo de cambio:</strong> <p class="parrafo">@item.MANTENIMIENTOVEHICULO.TIPOMANTENIMIENTO.Mantenimiento_Nombre </p>
                </div>
                <div class="mb-3">
                    <strong>Km a los que hacer el cambio:</strong> <p class="parrafo"> @item.ProximoMantenimiento_Km</p>
                </div>
                <div class="text-end">
                    @Html.ActionLink("Eliminar este próximo mantenimiento", "Delete", new { id = item.Id_ProximoMantenimiento }, new { @class = "btn btn-primary btn-sm " })
                </div>
            </div>
        }
    </div>
</body>