@model AutoCar360.Controllers.PROXIMOMANTENIMIENTO

@{
    ViewBag.Title = "Delete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background-color: #1c2c2c;
        color: #00cfff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .button-group {
        margin-top: 20px;
        display: flex;
        gap: 10px;
        justify-content: flex-start;
    }

    .botons {
        background-color: #2d3f3f;
        color: #00cfff;
        padding: 10px 20px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: background-color 0.3s ease;
        text-decoration: none;
    }

        .botons:hover {
            background-color: #3f5f5f;
        }
</style>

<h2>Delete</h2>

<h3>Estas seguro de borrar este</h3>
<div>
    <h4>PROXIMOMANTENIMIENTO</h4>
    <hr />
    <dl class="dl-horizontal">

        <dt>
            Matricula
        </dt>
        <dd>
            @Html.DisplayFor(mode => Model.MANTENIMIENTOVEHICULO.VEHICULOS.Vehiculo_Matricula) 
        </dd>

        <dt>
            Tipo de mantenimiento
        </dt>

        <dd>
            @Html.DisplayFor(mode => Model.MANTENIMIENTOVEHICULO.TIPOMANTENIMIENTO.Mantenimiento_Nombre)
        </dd>

    </dl>

    @using (Html.BeginForm()) {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Borrar" class="botons" /> 
            @Html.ActionLink("Volver", "Index", null, new { @class = "botons" })
        </div>
    }
</div>
