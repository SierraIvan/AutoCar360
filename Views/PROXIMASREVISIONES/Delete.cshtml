@model AutoCar360.Controllers.PROXIMASREVISIONES

@{
    ViewBag.Title = "Delete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background-color: #1c2c2c;
        color: #00cfff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .button-group {
        margin-top: 20px;
        display: flex;
        gap: 10px;
        justify-content: flex-start;
    }

    .botons {
        background-color: #2d3f3f;
        color: #00cfff;
        padding: 10px 20px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: background-color 0.3s ease;
        text-decoration: none;
    }

        .botons:hover {
            background-color: #3f5f5f;
        }
</style>

<h2>Delete</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>PROXIMASREVISIONES</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            Intervalo en Km
        </dt>

        <dd>
            @Html.DisplayFor(model => model.ProximaRevision_intervaloKm)
        </dd>

        <dt>
            Intervalo en tiempo
        </dt>

        <dd>
            @(( (DateTime)Model.ProximaRevision_intervaloTiempo).ToString("yyyy-MM-dd"))
        </dd>

        <dt>
           Matricula
        </dt>

        <dd>
            @Html.DisplayFor(model => model.REVISIONESVEHICULO.VEHICULOS.Vehiculo_Matricula)
        </dd>

    </dl>

    @using (Html.BeginForm()) {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Delete" class="botons" /> 
            @Html.ActionLink("Back to List", "Index", null, new { @class = "botons" })
        </div>
    }
</div>
