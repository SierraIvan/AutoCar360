@model AutoCar360.Controllers.MANTENIMIENTOVEHICULO

@{
    ViewBag.Title = "Crear Mantenimiento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background-color: #1c2c2c;
        color: #00cfff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    h2 {
        font-size: 28px;
        color: #00e1ff;
        margin-bottom: 40px;
        margin-left: 80px;
        text-align:center; 
    }

    .form-container {
        margin-left: 80px;
        max-width: 400px;
        
    }

    .form-group {
        margin-bottom: 20px;
    }

    label {
        font-weight: bold;
        display: block;
        margin-bottom: 5px;
        
    }

    .form-control {
        background-color: #1e3a3d;
        border: none;
        color: #00e1ff;
        padding: 10px;
        width: 100%;
    }

    .btn-crear {
        background-color: #1e3a3d;
        color: #00e1ff;
        border: none;
        padding: 10px 20px;
        cursor: pointer;
        border-radius:15%
    }
        .btn-crear:hover {
            background-color: #00e1ff;
            color: #132526;
            border;
            border-radius: 15%
        }

    .btn-back {
        font-size: 24px;
        color: #00e1ff;
        text-decoration: none;
        margin-left: 80px;
        display: inline-block;
        margin-top: 30px;
    }

        .btn-back:hover {
            color: #ffffff;
        }
</style>

<h2>Proximos Mantenimientos</h2>

<div class="form-container">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            <label>Matrícula</label>
            @Html.DropDownList("Id_Vehiculo", null, htmlAttributes: new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.Id_Vehiculo, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>Tipo Mantenimiento</label>
            @Html.DropDownList("Id_TipoMantenimiento", null, htmlAttributes: new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.Id_TipoMantenimiento, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>Intervalo Km</label>
            @Html.EditorFor(model => model.MantenimientoVehiculo_IntervaloKm, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.MantenimientoVehiculo_IntervaloKm, "", new { @class = "text-danger" })
        </div>

        <button type="submit" class="btn-crear">Crear</button>
    }

    <a href="@Url.Action("Index","PROXIMOMANTENIMIENTO")" class="btn-back">&#8592;</a>
</div>
