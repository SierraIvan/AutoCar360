        <h4>VEHICULOS</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        @* Campo oculto para el Id_Usuario (opcional si ya lo asignas en el controlador) *@
        @Html.HiddenFor(model => model.Id_Usuario)

