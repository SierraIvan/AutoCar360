@model AutoCar360.Controllers.VEHICULOS

@{
    ViewBag.Title = "Crear Nuevo Vehículo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid bg-dark text-light p-4">
    <h2 class="mb-4">@ViewBag.Title</h2>
    <div class="card bg-secondary text-light">
        <div class="card-body">
            @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "Por favor, corrige los siguientes errores:", new { @class = "text-danger" })

                @Html.HiddenFor(model => model.Id_Usuario)

                <div class="mb-3">
                    @Html.LabelFor(model => model.Id_Modelo, "Modelo", new { @class = "form-label" })
                    @Html.DropDownList("Id_Modelo", null, "Seleccionar Modelo", new { @class = "form-control bg-dark text-light border-secondary" })
                    @Html.ValidationMessageFor(model => model.Id_Modelo, null, new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.Id_Color, "Color", new { @class = "form-label" })
                    @Html.DropDownList("Id_Color", null, "Seleccionar Color", new { @class = "form-control bg-dark text-light border-secondary" })
                    @Html.ValidationMessageFor(model => model.Id_Color, null, new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.Vehiculo_Matricula, "Matrícula", new { @class = "form-label" })
                    @Html.EditorFor(model => model.Vehiculo_Matricula, new { htmlAttributes = new { @class = "form-control bg-dark text-light border-secondary" } })
                    @Html.ValidationMessageFor(model => model.Vehiculo_Matricula, null, new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.Vehiculo_Fecha_Matriculacion, "Fecha de Matriculación", new { @class = "form-label" })
                    @Html.EditorFor(model => model.Vehiculo_Fecha_Matriculacion, new { htmlAttributes = new { @class = "form-control datepicker bg-dark text-light border-secondary" } })
                    @Html.ValidationMessageFor(model => model.Vehiculo_Fecha_Matriculacion, null, new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.Vehiculo_Bastidor, "Número de Bastidor (VIN)", new { @class = "form-label" })
                    @Html.EditorFor(model => model.Vehiculo_Bastidor, new { htmlAttributes = new { @class = "form-control bg-dark text-light border-secondary" } })
                    @Html.ValidationMessageFor(model => model.Vehiculo_Bastidor, null, new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.Vehiculo_KmActuales, "Kilometraje Actual", new { @class = "form-label" })
                    @Html.EditorFor(model => model.Vehiculo_KmActuales, new { htmlAttributes = new { @class = "form-control bg-dark text-light border-secondary" } })
                    @Html.ValidationMessageFor(model => model.Vehiculo_KmActuales, null, new { @class = "text-danger" })
                </div>

                <div class="d-flex justify-content-end">
                    @Html.ActionLink("Volver", "Index", null, new { @class = "btn btn-outline-light me-2" })
                    <button type="submit" class="btn btn-primary">Guardar Vehículo</button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(function () {
            $('.datepicker').datepicker({
                dateFormat: 'dd/mm/yy',
                changeMonth: true,
                changeYear: true
            });
        });
    </script>
}

<style>
    body {
        background-color: #0a3a4a;
        color: #000;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
</style>