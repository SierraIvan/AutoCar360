@model AutoCar360.Controllers.VEHICULOS

@{
    ViewBag.Title = "Delete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background-color: #1c2c2c;
        color: #00cfff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .button-group {
        margin-top: 20px;
        display: flex;
        gap: 10px;
        justify-content: flex-start;
    }

    .botons {
        background-color: #2d3f3f;
        color: #00cfff;
        padding: 10px 20px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: background-color 0.3s ease;
        text-decoration: none;
    }

        .botons:hover {
            background-color: #3f5f5f;
        }
</style>

<h2>Eliminar</h2>

<h3>Seguro que quieres eliminar el vehiculo con matricula  @Html.DisplayFor(model => model.Vehiculo_Matricula)</h3>
<div>
    <h4>VEHICULOS</h4>
    <hr />


    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="button-group">
            <input type="submit" value="Eliminar" class="botons" />
            @Html.ActionLink("Volver", "Index", null, new { @class = "botons" })
        </div>
    }
</div>
