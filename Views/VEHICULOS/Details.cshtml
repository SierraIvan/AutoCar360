﻿@model AutoCar360.Controllers.VEHICULOS

@{
    ViewBag.Title = "Detalles de Vehículos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background-color: #1c2c2c;
        color: #00cfff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .detalles-container {
        text-align: center;
        color: cyan;
        font-family: Arial, sans-serif;
        padding: 40px;
    }

        .detalles-container h2 {
            font-size: 2em;
            font-weight: bold;
            margin-bottom: 30px;
        }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        justify-items: center;
        margin-bottom: 30px;
    }

    .info-box {
        background-color: #13272f;
        padding: 15px 30px;
        border-radius: 5px;
        font-weight: bold;
        font-size: 1.1em;
        min-width: 150px;
    }

    .action-buttons {
        display: flex;
        justify-content: center;
        gap: 40px;
    }

        .action-buttons a {
            background-color: #13272f;
            color: cyan;
            padding: 10px 20px;
            text-decoration: none;
            font-weight: bold;
            border-radius: 5px;
        }

            .action-buttons a:hover {
                background-color: #0d1c21;
            }
</style>

<div class="detalles-container">
    <h2>DETALLES DE VEHICULOS</h2>

    <div class="info-grid">
        <div class="info-box">Marca: @Html.DisplayFor(model => model.MODELOS.MARCAS.Marca_Nombre)</div>
        <div class="info-box">Modelo: @Html.DisplayFor(model => model.MODELOS.Modelo_Nombre)</div>
        <div class="info-box">Color: @Html.DisplayFor(model => model.COLORES.Color_Nombre)</div>

        <div class="info-box">Matricula: @Html.DisplayFor(model => model.Vehiculo_Matricula)</div>
        <div class="info-box">
            Fecha Matriculación: @(Model.Vehiculo_Fecha_Matriculacion?.ToString("dd/MM/yyyy"))
        </div>

        <div class="info-box">Bastidor: @Html.DisplayFor(model => model.Vehiculo_Bastidor)</div>

        <div class="info-box" style="grid-column: 2 / span 1;">Km: @Html.DisplayFor(model => model.Vehiculo_KmActuales)</div>
    </div>

    <div class="action-buttons">
        @Html.ActionLink("Modificar", "Edit", new { id = Model.Id_Vehiculo })
        @Html.ActionLink("Volver", "Index")
    </div>
</div>