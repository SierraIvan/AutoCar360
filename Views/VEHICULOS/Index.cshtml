@model IEnumerable<AutoCar360.Controllers.VEHICULOS>

@{
    ViewBag.Title = "Tus Vehículos";
    Layout = "~/Views/Shared/_Layout.cshtml";
    Random rnd = new Random();
    int numero1 = rnd.Next(1, 5);
    int numero2;
    do
    {
        numero2 = rnd.Next(1, 5);
    } while (numero2 == numero1);

    string ObtenerRutaImagen(int num)
    {
        switch (num)
        {
            case 1: return Url.Content("~/Imagenes/bateria.jpg");
            case 2: return Url.Content("~/Imagenes/ruedas.jpg");
            case 3: return Url.Content("~/Imagenes/revision_ITV.jpg");
            case 4: return Url.Content("~/Imagenes/aceites_de_motor.jpg");
            default: return Url.Content("~/Imagenes/Logo360.png");
        }
    }

    string rutaImagen1 = ObtenerRutaImagen(numero1);
    string rutaImagen2 = ObtenerRutaImagen(numero2);
}


<body>
    <div class="imagen-lateral izquierda">
        <img src="@rutaImagen1" alt="Consejo de mantenimiento">
    </div>

    <div class="vehiculos-container">
        <div class="top-bar">
            <h2>Tus Vehículos</h2>
            <a href="@Url.Action("Create")" class="boton-add">Añadir</a>
        </div>

        <div class="vehiculo-lista">
            @foreach (var item in Model)
            {
                <div class="vehiculo-card">
                    <div>
                        @if (item.MODELOS.CARROCERIAS.TIPOVEHICULO.TipoVehiculo_Nombre == "Coche")
                        {
                            <img src="~/imagenes/coche.png" alt="Coche" style="width:40px" />
                        }
                        else if (item.MODELOS.CARROCERIAS.TIPOVEHICULO.TipoVehiculo_Nombre == "Moto")
                        {
                            <img src="~/imagenes/moto.png" alt="Moto" style="width:40px" />
                        }
                        else if (item.MODELOS.CARROCERIAS.TIPOVEHICULO.TipoVehiculo_Nombre == "Camion")
                        {
                            <img src="~/imagenes/Camion.png" alt="Camion" style="width:40px" />
                        }
                        else if (item.MODELOS.CARROCERIAS.TIPOVEHICULO.TipoVehiculo_Nombre == "Furgoneta")
                        {
                            <img src="~/imagenes/Furgoneta.png" alt="Furgoneta" style="width:40px" />
                        }
                        else
                        {
                            <span>@item.MODELOS.CARROCERIAS.TIPOVEHICULO.TipoVehiculo_Nombre</span>
                        }
                    </div>
                    <div class="vehiculo-info">
                        <div><strong>Matrícula:</strong> @item.Vehiculo_Matricula</div>
                        <div><strong>Km actuales:</strong> @item.Vehiculo_KmActuales</div>
                        <div><strong>Modelo:</strong> @item.MODELOS.Modelo_Nombre</div>
                    </div>
                    <div class="vehiculo-acciones">
                        @Html.ActionLink("Editar", "Edit", new { id = item.Id_Vehiculo }, new { @class = "boton-card" })
                        @Html.ActionLink("Detalles", "Details", new { id = item.Id_Vehiculo }, new { @class = "boton-card" })
                        @Html.ActionLink("Eliminar", "Delete", new { id = item.Id_Vehiculo }, new { @class = "boton-card" })
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="imagen-lateral derecha">
        <img src="@rutaImagen2" alt="Consejo de mantenimiento">
    </div>
</body>
<style>
    body {
        background-color: #1c2c2c;
        color: #00cfff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        margin: 0;
        padding: 0;
        position: relative;
        min-height: 100vh;
    }

    .imagen-lateral {
        position:absolute;
        top: 0;
        height: 100vh;
        width: 250px; 
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: -1;
        margin-left:1%;
        margin-right:1%;

            }

        .imagen-lateral img {
            max-height: 100%;
            max-width: 100%;
            
        }

    .izquierda {
        left: 0;
    }

    .derecha {
        right: 0;
    }

    .vehiculos-container {
        padding: 20px;
        max-width: 950px;
        margin: 0 auto;
        position: relative;
        z-index: 1;
        background-color: rgba(28, 44, 44, 0.9); 
    }

    h2 {
        color: #00cfff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-weight: bold;
    }

    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .boton-add {
        background-color: #2d3f3f;
        padding: 8px 16px;
        text-decoration: none;
        color: #00cfff;
        margin-bottom: 10px;
        border-radius: 5px;
    }

        .boton-add:hover {
            font-weight: bold;
        }

    .vehiculo-lista {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .vehiculo-card {
        background-color: #2d3f3f;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px;
        border-radius: 6px;
    }

    .vehiculo-icono .icono {
        background-color: red;
        color: white;
        padding: 20px;
        text-align: center;
        font-weight: bold;
        border-radius: 4px;
    }

    .vehiculo-info {
        flex: 1;
        padding: 0 20px;
    }

    .vehiculo-acciones {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .boton-card {
        background-color: #2d3f3f;
        text-decoration: none;
        color: #00cfff;
        border-radius: 5px;
    }

        .boton-card:hover {
            font-weight: bold;
        }
</style>