@model IEnumerable<AutoCar360.Controllers.VEHICULOS>

@{
    ViewBag.Title = "Tus Vehículos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="vehiculos-container">
    <div class="top-bar">
        <h2>Tus Vehículos</h2>
        <a href="@Url.Action("Create")" class="btn-add">Añadir</a>
    </div>

    <div class="vehiculo-lista">
        @foreach (var item in Model)
        {
            <div class="vehiculo-card">
                <div class="vehiculo-icono">
                    <div class="icono">icono</div>
                </div>
                <div class="vehiculo-info">
                    <div><strong>Matrícula:</strong> @item.Vehiculo_Matricula</div>
                    <div><strong>Km actuales:</strong> @item.Vehiculo_KmActuales</div>
                    <div><strong>Modelo:</strong> @item.MODELOS.Modelo_Nombre</div>
                </div>
                <div class="vehiculo-acciones">
                    @Html.ActionLink("Editar", "Edit", new { id = item.Id_Vehiculo }, new { @class = "btn-accion" })
                    @Html.ActionLink("Detalles", "Details", new { id = item.Id_Vehiculo }, new { @class = "btn-accion" })
                    @Html.ActionLink("Eliminar", "Delete", new { id = item.Id_Vehiculo }, new { @class = "btn-accion" })
                </div>
            </div>
        }
    </div>
</div>

<style>
    body {
        background-color: #0a3a4a;
        color: #000;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .vehiculos-container {
        padding: 20px;
        max-width: 1000px;
        margin: auto;
    }

    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

        .top-bar h2 {
            color: #fff;
        }

    .btn-add {
        background-color: #f0f0f0;
        padding: 8px 16px;
        text-decoration: none;
        font-weight: bold;
        border-radius: 4px;
    }

    .vehiculo-lista {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .vehiculo-card {
        background-color: #eee;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px;
        border-radius: 6px;
    }

    .vehiculo-icono .icono {
        background-color: red;
        color: white;
        padding: 20px;
        text-align: center;
        font-weight: bold;
        border-radius: 4px;
    }

    .vehiculo-info {
        flex: 1;
        padding: 0 20px;
    }

    .vehiculo-acciones {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .btn-accion {
        background-color: transparent;
        border: none;
        color: black;
        text-decoration: underline;
        cursor: pointer;
    }

        .btn-accion:hover {
            font-weight: bold;
        }
</style>
