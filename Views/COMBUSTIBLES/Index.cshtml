@model IEnumerable<AutoCar360.Controllers.COMBUSTIBLE>

@{
    ViewBag.Title = "Lista de Combustibles";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Lista de Combustibles</h2>
    <img src="~/Imagenes/logo360.png" alt="AutoCar360 Logo" class="img-fluid" style="height: 100px; width: 130px">
</div>

<p>
    <a href="@Url.Action("Create")" class="btn btn-success">
        <i class="fas fa-plus"></i> Agregar Nuevo
    </a>
</p>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th class="text-start">Nombre del Combustible</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="text-start">@Html.DisplayFor(modelItem => item.Combustible_Nombre)</td>
                <td class="text-center">
                    <a href="@Url.Action("Edit", new { id = item.Id_Combustible })" class="btn btn-warning btn-sm">
                        <i class="fas fa-edit"></i> Editar
                    </a>
                    <a href="@Url.Action("Details", new { id = item.Id_Combustible })" class="btn btn-info btn-sm">
                        <i class="fas fa-info-circle"></i> Detalles
                    </a>
                    <a href="@Url.Action("Delete", new { id = item.Id_Combustible })" class="btn btn-danger btn-sm">
                        <i class="fas fa-trash"></i> Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Botón de Volver al Home -->
<div class="text-start mt-4">
    <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">
        <i class="fas fa-home"></i> Volver al Inicio
    </a>
</div>


